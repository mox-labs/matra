{
	"name": "matra-site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/verify-base-path.ts build && pagefind --site build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && bun scripts/check-contrast.ts && bun scripts/check-mark.ts",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@shikijs/rehype": "4.4.3",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/d3-scale": "4.0.9",
		"@types/hast": "3.0.5",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.2",
		"d3-scale": "4.0.2",
		"hast-util-from-html": "2.0.3",
		"hast-util-to-html": "9.0.5",
		"hast-util-to-string": "3.0.1",
		"pagefind": "1.5.2",
		"rehype-raw": "7.0.0",
		"rehype-slug": "6.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"shiki": "4.4.3",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "7.0.2",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"vite": "8.3.0"
	}
}
